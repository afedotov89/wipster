# Explicit shell/container environment: settings do not automatically load this file.
DEBUG=true
SECRET_KEY=development-only-not-for-production
DATABASE_URL=sqlite:////tmp/wipster-development.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional local SMS simulation. Requires both DEBUG and DEV_OTP_ENABLED.
OTP_PROVIDER=disabled
DEV_OTP_ENABLED=false
CORS_ALLOWED_ORIGINS=
