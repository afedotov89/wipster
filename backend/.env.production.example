DEBUG=false
# Generate securely: python -c 'import secrets; print(secrets.token_urlsafe(64))'
SECRET_KEY=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/wipster?sslmode=verify-full
ALLOWED_HOSTS=wipster.fedotovs.net
# Google-only. Create a Desktop app client; no Twilio account is required.
GOOGLE_ENABLED=true
GOOGLE_CLIENT_ID=
# Optional Desktop client secret, server only; never VITE_* or Tauri configuration.
GOOGLE_CLIENT_SECRET=
OTP_PROVIDER=disabled
DEV_OTP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Enable only behind an ingress that overwrites X-Forwarded-Proto.
TRUST_PROXY_TLS=false
# Native uses Rust networking; no CORS origins are needed.
CORS_ALLOWED_ORIGINS=
