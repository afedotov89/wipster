[Unit]
Description=Back up only Wipster PostgreSQL
After=docker.service
Requires=docker.service
[Service]
Type=oneshot
User=fedotov
Group=fedotov
UMask=0077
ExecStart=/srv/wipster/bin/backup.sh
TimeoutStartSec=10min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/wipster/runtime /srv/wipster/backups
